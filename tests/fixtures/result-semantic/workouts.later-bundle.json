        "strategy": "sequence",
        "strategyConfig": {},
        "children": [
          {
            "id": "blocks",
            "type": "container",
            "strategy": "emom",
            "strategyConfig": { "cycles": 3, "interval": { "value": 1, "unit": "minute" } },
            "resultCapture": { "mode": "scored", "scoreType": "intervals", "childDetail": "optional" },
            "children": [
