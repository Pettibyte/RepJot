{
  "format": "repjot/workouts",
  "schemaVersion": 1,
  "workouts": [
    {
      "id": "squat-day",
      "name": "Squat Day",
      "root": {
        "id": "root",
        "type": "container",
        "strategy": "sequence",
        "strategyConfig": {},
        "children": [
          {
            "id": "squat-sets",
            "type": "container",
            "strategy": "rounds",
            "strategyConfig": { "rounds": 2 },
            "children": [
              {
                "id": "set-1",
                "type": "exercise",
                "exerciseId": "back-squat",
                "stimulus": "strength",
                "setType": "working",
                "prescription": { "reps": 5, "weight": { "value": 100, "unit": "kg" } }
              },
              {
                "id": "raise-1",
                "type": "exercise",
                "exerciseId": "lateral-raise",
                "stimulus": "hypertrophy",
                "prescription": { "reps": 12, "weight": { "value": 12, "unit": "kg" } }
              }
            ]
          },
          {
            "id": "singles",
            "type": "container",
            "strategy": "sequence",
            "strategyConfig": {},
            "children": [
              {
                "id": "dead-1",
                "type": "exercise",
                "exerciseId": "deadlift",
                "stimulus": "strength",
                "prescription": { "reps": 3, "weight": { "value": 150, "unit": "kg" } }
              }
            ]
          },
          {
            "id": "finisher",
            "type": "container",
            "name": "Finisher",
            "strategy": "amrap",
            "strategyConfig": { "duration": { "value": 20, "unit": "minute" } },
            "resultCapture": { "mode": "scored", "scoreType": "rounds_and_reps", "childDetail": "optional" },
            "children": [
              {
                "id": "push-1",
                "type": "exercise",
                "exerciseId": "push-up",
                "stimulus": "conditioning",
                "prescription": { "reps": 20 }
