{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repjot.com/schemas/exercises/v1.schema.json",
  "title": "REP JOT Exercise Directory",
  "description": "Exercise reference data for REP JOT. Generated by the seed script from free-exercise-db. See specs/rep-jot-json-schema-spec.md section 2 and specs/exercise-seeding.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "exercises"],
  "properties": {
    "format": { "const": "repjot/exercises" },
    "schemaVersion": { "const": 1 },
    "exercises": {
      "type": "array",
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": {
      "description": "ID segment. Bans '/', '|', and ':' (composite result key separators) and rejects an all-digit key (integer-like Record keys reorder in JavaScript).",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![0-9]+$)[^/|:]+$"
    },
    "equipmentValue": {
      "description": "Closed equipment vocabulary. Every value is lower case and singular. The seed folds source spellings such as 'Kettlebells' into this set and fails on any value outside it. The seed also rejects this list if a value is not already lower case and singular.",
      "enum": [
        "band",
        "barbell",
        "cable",
        "dumbbell",
        "e-z curl bar",
        "exercise ball",
        "foam roll",
        "kettlebell",
        "machine",
        "medicine ball",
        "other"
      ]
    },
    "icon": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "material_symbol" },
            "name": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "local_svg" },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.svg$"
            }
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "instructions",
        "equipment",
        "force",
        "mechanic",
        "category",
        "level",
        "movementPattern",
        "primaryMuscles",
        "secondaryMuscles",
        "laterality",
        "measurements",
        "loadSemantics"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "icon": { "$ref": "#/$defs/icon" },
        "equipment": {
          "description": "Required equipment. The seed normalizes the source value or the allowlist override into this closed vocabulary and maps 'body only' to null. null means no equipment.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/equipmentValue" }
          ]
        },
        "force": {
          "type": ["string", "null"],
          "enum": ["push", "pull", "static", null]
        },
        "mechanic": {
          "type": ["string", "null"],
          "enum": ["compound", "isolation", null]
        },
        "category": {
          "enum": [
            "strength",
            "stretching",
            "plyometrics",
            "strongman",
            "powerlifting",
            "cardio",
            "olympic weightlifting"
          ]
        },
        "level": {
          "description": "Difficulty copied verbatim from the source.",
          "enum": ["beginner", "intermediate", "expert"]
        },
        "movementPattern": {
          "enum": [
            "squat",
            "hinge",
            "horizontal_push",
            "vertical_push",
            "horizontal_pull",
            "vertical_pull",
            "carry",
            "locomotion",
            "rotation",
            "anti_rotation",
            "flexion",
            "extension",
            "other",
            "none"
          ]
        },
        "primaryMuscles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/muscle" }
        },
        "secondaryMuscles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/muscle" }
        },
        "laterality": { "enum": ["bilateral", "unilateral"] },
        "measurements": {
          "description": "Unique dimensions. uniqueItems catches identical objects only, so the seed enforces one entry per dimension and fails on a repeated dimension name.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/measurementSupport" }
        },
        "loadSemantics": {
          "enum": ["total", "per_implement", "added", "assisted"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measurements": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "dimension": { "const": "weight" } },
                  "required": ["dimension"]
                }
              }
            },
            "required": ["measurements"]
          },
          "then": {
            "properties": {
              "loadSemantics": { "enum": ["total", "per_implement"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurements": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "dimension": { "const": "addedWeight" } },
                  "required": ["dimension"]
                }
              }
            },
            "required": ["measurements"]
          },
          "then": {
            "properties": { "loadSemantics": { "const": "added" } }
          }
        },
        {
          "if": {
            "properties": {
              "measurements": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "dimension": { "const": "assistedWeight" } },
                  "required": ["dimension"]
                }
              }
            },
            "required": ["measurements"]
          },
          "then": {
            "properties": { "loadSemantics": { "const": "assisted" } }
          }
        }
      ]
    },
    "muscle": {
      "enum": [
        "abdominals",
        "abductors",
        "adductors",
        "biceps",
        "calves",
        "chest",
        "forearms",
        "glutes",
        "hamstrings",
        "lats",
        "lower back",
        "middle back",
        "neck",
        "quadriceps",
        "shoulders",
        "traps",
        "triceps"
      ]
    },
    "measurementSupport": {
      "oneOf": [
        { "$ref": "#/$defs/repsMeasurement" },
        { "$ref": "#/$defs/weightMeasurement" },
        { "$ref": "#/$defs/addedWeightMeasurement" },
        { "$ref": "#/$defs/assistedWeightMeasurement" },
        { "$ref": "#/$defs/distanceMeasurement" },
        { "$ref": "#/$defs/durationMeasurement" },
        { "$ref": "#/$defs/caloriesMeasurement" }
      ]
    },
    "repsMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "reps" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "reps" }
        }
      }
    },
    "weightMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "weight" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["lb", "kg"] }
        }
      }
    },
    "addedWeightMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "addedWeight" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["lb", "kg"] }
        }
      }
    },
    "assistedWeightMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "assistedWeight" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["lb", "kg"] }
        }
      }
    },
    "distanceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "distance" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["m", "km", "ft", "mi"] }
        }
      }
    },
    "durationMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "duration" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["second", "minute"] }
        }
      }
    },
    "caloriesMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "compatibleUnits"],
      "properties": {
        "dimension": { "const": "calories" },
        "compatibleUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "kcal" }
        }
      }
    }
  }
}
