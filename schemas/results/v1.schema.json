{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repjot.com/schemas/results/v1.schema.json",
  "title": "REP JOT Monthly Workout Results",
  "description": "One UTC month of workout sessions for REP JOT. Sessions, exercise results, and container results are keyed maps. There are no session tombstones, no frozen execution plans, and no sync copies. See specs/rep-jot-json-schema-spec.md section 5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "yearMonthUtc", "sessions"],
  "properties": {
    "format": { "const": "repjot/results" },
    "schemaVersion": { "const": 1 },
    "yearMonthUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "sessions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/sessionKey" },
      "additionalProperties": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "identifier": {
      "description": "ID segment. Bans '/', '|', and ':' (composite result key separators) and rejects an all-digit key (integer-like Record keys reorder in JavaScript).",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![0-9]+$)[^/|:]+$"
    },
    "sessionKey": {
      "description": "Session Record key. The 'session-' prefix keeps the key from being integer-like. The key must equal the session 'id'; that equality is a loader and build check, not a schema check.",
      "type": "string",
      "pattern": "^session-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "encodedPath": {
      "description": "Execution path encoded for a Record key. Segments join with '/'. A repeated-container segment carries ':<iteration>', one-based.",
      "type": "string",
      "pattern": "^[^/|:]+(:[0-9]+)?(/[^/|:]+(:[0-9]+)?)*$"
    },
    "exerciseResultKey": {
      "description": "Key shape '<path>|<side>|<attempt>'. The application always writes both fields, even at their defaults. Key-to-value agreement is a loader and build check, not a schema check.",
      "type": "string",
      "pattern": "^[^/|:]+(:[0-9]+)?(/[^/|:]+(:[0-9]+)?)*\\|(both|left|right|alternating)\\|[0-9]+$"
    },
    "containerResultKey": {
      "description": "Key shape '<path>|<attempt>'. The application always writes the field, even at its default. Key-to-value agreement is a loader and build check, not a schema check.",
      "type": "string",
      "pattern": "^[^/|:]+(:[0-9]+)?(/[^/|:]+(:[0-9]+)?)*\\|[0-9]+$"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workoutId",
        "status",
        "startedAtUtc",
        "updatedAtUtc",
        "exerciseResults",
        "containerResults"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/sessionKey" },
        "workoutId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["in_progress", "completed", "abandoned"] },
        "startedAtUtc": {
          "description": "UTC session start. Selects the shard. Immutable after it is written.",
          "allOf": [{ "$ref": "#/$defs/utcTimestamp" }]
        },
        "completedAtUtc": {
          "description": "Terminal instant for a 'completed' or 'abandoned' session. Immutable after it is written. Forbidden for 'in_progress'.",
          "allOf": [{ "$ref": "#/$defs/utcTimestamp" }]
        },
        "updatedAtUtc": {
          "description": "System-managed. The application sets it on every saved write.",
          "allOf": [{ "$ref": "#/$defs/utcTimestamp" }]
        },
        "exerciseResults": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/exerciseResultKey" },
          "additionalProperties": { "$ref": "#/$defs/exerciseResult" }
        },
        "containerResults": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/containerResultKey" },
          "additionalProperties": { "$ref": "#/$defs/containerResult" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "in_progress" } },
            "required": ["status"]
          },
          "then": { "properties": { "completedAtUtc": false } },
          "else": {
            "required": ["completedAtUtc"],
            "properties": { "completedAtUtc": { "$ref": "#/$defs/utcTimestamp" } }
          }
        }
      ]
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "iteration": { "type": "integer", "minimum": 1 }
      }
    },
    "executionPath": {
      "description": "Structured path from the workout root to the result's programmed node. The Record key derives from it.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pathSegment" }
    },
    "resultStatus": {
      "enum": ["completed", "incomplete", "skipped"]
    },
    "reasonCode": {
      "enum": [
        "user_skipped",
        "not_completed",
        "equipment_unavailable",
        "physical_limitation",
        "time_constraint",
        "unsuccessful_attempt",
        "other"
      ]
    },
    "repsQuantity": {
      "description": "A repetition result is an explicit quantity with a non-negative integer value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "unit": { "const": "reps" }
      }
    },
    "weightQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["lb", "kg"] }
      }
    },
    "distanceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["m", "km", "ft", "mi"] }
      }
    },
    "durationQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["second", "minute"] }
      }
    },
    "caloriesQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "const": "kcal" }
      }
    },
    "resultValues": {
      "description": "Actual measured values with explicit units. Absent means no measured data.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "reps": { "$ref": "#/$defs/repsQuantity" },
        "weight": { "$ref": "#/$defs/weightQuantity" },
        "addedWeight": { "$ref": "#/$defs/weightQuantity" },
        "assistedWeight": { "$ref": "#/$defs/weightQuantity" },
        "distance": { "$ref": "#/$defs/distanceQuantity" },
        "duration": { "$ref": "#/$defs/durationQuantity" },
        "calories": { "$ref": "#/$defs/caloriesQuantity" }
      }
    },
    "effortOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "achieved"],
          "properties": {
            "type": { "const": "failure" },
            "achieved": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "rir" },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "rpe" },
            "value": { "type": "number", "minimum": 1, "maximum": 10 }
          }
        }
      ]
    },
    "exerciseResult": {
      "description": "One exercise result. The map name carries the kind, so there is no 'type' field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workoutId", "executionPath", "exerciseId", "status"],
      "properties": {
        "workoutId": { "$ref": "#/$defs/identifier" },
        "executionPath": { "$ref": "#/$defs/executionPath" },
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "side": { "enum": ["left", "right", "both", "alternating"] },
        "startingSide": { "enum": ["left", "right"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/resultStatus" },
        "values": { "$ref": "#/$defs/resultValues" },
        "effort": { "$ref": "#/$defs/effortOutcome" },
        "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "endedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "side": { "const": "alternating" } },
            "required": ["side"]
          },
          "then": {
            "required": ["startingSide"],
            "properties": { "startingSide": { "enum": ["left", "right"] } }
          },
          "else": { "properties": { "startingSide": false } }
        },
        {
          "if": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              { "required": ["values"], "properties": { "values": true } },
              { "required": ["effort"], "properties": { "effort": true } },
              { "required": ["startedAtUtc"], "properties": { "startedAtUtc": true } },
              { "required": ["endedAtUtc"], "properties": { "endedAtUtc": true } }
            ],
            "properties": { "reasonCode": false }
          },
          "else": {
            "required": ["reasonCode"],
            "properties": { "reasonCode": { "$ref": "#/$defs/reasonCode" } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "skipped" } },
            "required": ["status"]
          },
          "then": { "properties": { "values": false } }
        }
      ]
    },
    "score": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "completedCycles"],
          "properties": {
            "type": { "const": "cycles" },
            "completedCycles": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "completedRounds", "additionalReps"],
          "properties": {
            "type": { "const": "rounds_and_reps" },
            "completedRounds": { "type": "integer", "minimum": 0 },
            "additionalReps": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "completedIntervals", "totalIntervals"],
          "properties": {
            "type": { "const": "intervals" },
            "completedIntervals": { "type": "integer", "minimum": 0 },
            "totalIntervals": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "nonstandard" } }
        }
      ]
    },
    "containerResult": {
      "description": "One scored-container result. The map name carries the kind, so there is no 'type' field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workoutId", "executionPath", "status"],
      "properties": {
        "workoutId": { "$ref": "#/$defs/identifier" },
        "executionPath": { "$ref": "#/$defs/executionPath" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/resultStatus" },
        "score": { "$ref": "#/$defs/score" },
        "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "endedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["score"],
            "properties": { "reasonCode": false, "score": { "$ref": "#/$defs/score" } }
          },
          "else": {
            "required": ["reasonCode"],
            "properties": { "reasonCode": { "$ref": "#/$defs/reasonCode" } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "skipped" } },
            "required": ["status"]
          },
          "then": { "properties": { "score": false } }
        }
      ]
    }
  }
}
