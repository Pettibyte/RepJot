{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repjot.com/schemas/results/v1.schema.json",
  "title": "REP JOT Monthly Workout Results",
  "description": "One UTC month of workout sessions, results, and deletion tombstones for REP JOT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "yearMonthUtc", "sessions", "sessionTombstones"],
  "properties": {
    "format": { "const": "repjot/results" },
    "schemaVersion": { "const": 1 },
    "yearMonthUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    },
    "sessionTombstones": {
      "type": "array",
      "items": { "$ref": "#/$defs/sessionTombstone" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1 },
    "sessionId": {
      "type": "string",
      "pattern": "^session-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sessionTombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "deletedAtUtc"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "deletedAtUtc": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workoutId", "status", "startedAtUtc", "updatedAtUtc", "results"],
      "properties": {
        "id": { "$ref": "#/$defs/sessionId" },
        "workoutId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["in_progress", "completed", "abandoned"] },
        "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "endedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "updatedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "conflictOfSessionId": { "$ref": "#/$defs/sessionId" },
        "executionPlan": { "$ref": "https://repjot.com/schemas/workouts/v1.schema.json#/$defs/containerNode" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "in_progress" } },
            "required": ["status"]
          },
          "then": {
            "required": ["executionPlan"],
            "properties": { "executionPlan": true, "endedAtUtc": false }
          },
          "else": {
            "required": ["endedAtUtc"],
            "properties": { "endedAtUtc": true, "executionPlan": false }
          }
        }
      ]
    },
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/exerciseResult" },
        { "$ref": "#/$defs/containerResult" }
      ]
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "iteration": { "type": "integer", "minimum": 1 }
      }
    },
    "executionPath": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pathSegment" }
    },
    "resultStatus": {
      "enum": ["completed", "incomplete", "skipped"]
    },
    "reasonCode": {
      "enum": [
        "deprecated",
        "user_skipped",
        "not_completed",
        "equipment_unavailable",
        "physical_limitation",
        "time_constraint",
        "unsuccessful_attempt",
        "other"
      ]
    },
    "weightQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["lb", "kg"] }
      }
    },
    "distanceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["m", "km", "ft", "mi"] }
      }
    },
    "durationQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["second", "minute"] }
      }
    },
    "caloriesQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "const": "kcal" }
      }
    },
    "resultValues": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "reps": { "type": "integer", "minimum": 0 },
        "weight": { "$ref": "#/$defs/weightQuantity" },
        "addedWeight": { "$ref": "#/$defs/weightQuantity" },
        "assistedWeight": { "$ref": "#/$defs/weightQuantity" },
        "distance": { "$ref": "#/$defs/distanceQuantity" },
        "duration": { "$ref": "#/$defs/durationQuantity" },
        "calories": { "$ref": "#/$defs/caloriesQuantity" }
      }
    },
    "effortOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "achieved"],
          "properties": {
            "type": { "const": "failure" },
            "achieved": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "rir" },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "rpe" },
            "value": { "type": "number", "minimum": 1, "maximum": 10 }
          }
        }
      ]
    },
    "exerciseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "workoutId", "executionPath", "exerciseId", "status"],
      "properties": {
        "type": { "const": "exercise" },
        "workoutId": { "$ref": "#/$defs/identifier" },
        "executionPath": { "$ref": "#/$defs/executionPath" },
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "attempt": { "type": "integer", "minimum": 1 },
        "side": { "enum": ["left", "right", "both", "alternating"] },
        "startingSide": { "enum": ["left", "right"] },
        "status": { "$ref": "#/$defs/resultStatus" },
        "values": { "$ref": "#/$defs/resultValues" },
        "effort": { "$ref": "#/$defs/effortOutcome" },
        "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "endedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "side": { "const": "alternating" } },
            "required": ["side"]
          },
          "then": {
            "required": ["startingSide"],
            "properties": { "startingSide": true }
          },
          "else": { "properties": { "startingSide": false } }
        },
        {
          "if": {
            "properties": { "status": { "const": "skipped" } },
            "required": ["status"]
          },
          "then": { "properties": { "values": false } }
        }
      ]
    },
    "score": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "completedCycles"],
          "properties": {
            "type": { "const": "cycles" },
            "completedCycles": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "completedRounds", "additionalReps"],
          "properties": {
            "type": { "const": "rounds_and_reps" },
            "completedRounds": { "type": "integer", "minimum": 0 },
            "additionalReps": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "completedIntervals", "totalIntervals"],
          "properties": {
            "type": { "const": "intervals" },
            "completedIntervals": { "type": "integer", "minimum": 0 },
            "totalIntervals": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "nonstandard" } }
        }
      ]
    },
    "containerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "workoutId", "executionPath", "status"],
      "properties": {
        "type": { "const": "container" },
        "workoutId": { "$ref": "#/$defs/identifier" },
        "executionPath": { "$ref": "#/$defs/executionPath" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "score": { "$ref": "#/$defs/score" },
        "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "endedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["score"],
            "properties": { "score": true }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "skipped" } },
            "required": ["status"]
          },
          "then": { "properties": { "score": false } }
        }
      ]
    }
  }
}
