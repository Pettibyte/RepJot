{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repjot.com/schemas/workouts/v1.schema.json",
  "title": "REP JOT Workouts",
  "description": "Workout definitions and programmed prescriptions for REP JOT. See specs/rep-jot-json-schema-spec.md section 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "workouts"],
  "properties": {
    "format": { "const": "repjot/workouts" },
    "schemaVersion": { "const": 1 },
    "workouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/workout" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": {
      "description": "ID segment. Bans '/', '|', and ':' (composite result key separators) and rejects an all-digit key (integer-like Record keys reorder in JavaScript).",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![0-9]+$)[^/|:]+$"
    },
    "weightQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["lb", "kg"] }
      }
    },
    "distanceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["m", "km", "ft", "mi"] }
      }
    },
    "durationQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["second", "minute"] }
      }
    },
    "positiveDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["second", "minute"] }
      }
    },
    "caloriesQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "const": "kcal" }
      }
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "root"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "notes": { "type": "string" },
        "root": { "$ref": "#/$defs/containerNode" }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/containerNode" },
        { "$ref": "#/$defs/exerciseNode" }
      ]
    },
    "containerNode": {
      "description": "Ordered container of nodes. strategy selects the execution model and the shape of strategyConfig. Node IDs are unique within one workout; the same node ID MAY appear in two workouts. Duplicate node IDs inside one workout are a build-time check, not a schema check.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "strategy", "strategyConfig", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "container" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "strategy": {
          "enum": ["sequence", "rounds", "amrap", "emom", "complex"]
        },
        "strategyConfig": { "type": "object" },
        "resultCapture": { "$ref": "#/$defs/resultCapture" },
        "benchmark": { "$ref": "#/$defs/benchmark" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "strategy": { "const": "sequence" } },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "strategyConfig": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": { "strategy": { "const": "rounds" } },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "strategyConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rounds"],
                "properties": {
                  "rounds": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "strategy": { "const": "amrap" } },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "strategyConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": ["duration"],
                "properties": {
                  "duration": { "$ref": "#/$defs/positiveDuration" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "strategy": { "const": "emom" } },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "strategyConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cycles", "interval"],
                "properties": {
                  "cycles": { "type": "integer", "minimum": 1 },
                  "interval": { "$ref": "#/$defs/positiveDuration" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "strategy": { "const": "complex" } },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "strategyConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cycles"],
                "properties": {
                  "cycles": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "resultCapture": {
      "description": "Container score and child-detail rules. childDetail 'none' forbids child exercise results; 'optional' allows absent, partial, or complete detail.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scoreType", "childDetail"],
      "properties": {
        "mode": { "const": "scored" },
        "scoreType": { "enum": ["cycles", "rounds_and_reps", "intervals"] },
        "childDetail": { "enum": ["none", "optional"] }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "organization": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "exerciseNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "exerciseId", "stimulus", "prescription"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "exercise" },
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "stimulus": {
          "enum": ["strength", "hypertrophy", "power", "conditioning", "mobility"]
        },
        "setType": { "enum": ["warmup", "working"] },
        "prescription": { "$ref": "#/$defs/prescription" },
        "notes": { "type": "string" }
      }
    },
    "repsPrescription": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "qualifier"],
          "properties": {
            "target": { "type": "integer", "minimum": 0 },
            "qualifier": { "const": "approximate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "effortTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "failure" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "rir" },
            "target": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "rpe" },
            "target": { "type": "number", "minimum": 1, "maximum": 10 }
          }
        }
      ]
    },
    "loadStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["fixed", "ascending", "descending", "self_selected"] },
        "firstIteration": { "const": "maximal_for_prescription" },
        "adjustment": { "const": "decrease_to_repeat_effort" }
      }
    },
    "iterationPrescription": {
      "description": "One-based override for the nearest repeated container. Overrides only the fields it contains; omitted fields inherit the top-level value. Each iteration number appears at most once, which is a build-time check, not a schema check.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "required": ["iteration"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 1 },
        "reps": { "$ref": "#/$defs/repsPrescription" },
        "weight": { "$ref": "#/$defs/weightQuantity" },
        "addedWeight": { "$ref": "#/$defs/weightQuantity" },
        "assistedWeight": { "$ref": "#/$defs/weightQuantity" },
        "distance": { "$ref": "#/$defs/distanceQuantity" },
        "duration": { "$ref": "#/$defs/durationQuantity" },
        "calories": { "$ref": "#/$defs/caloriesQuantity" },
        "effort": { "$ref": "#/$defs/effortTarget" },
        "loadStrategy": { "$ref": "#/$defs/loadStrategy" }
      }
    },
    "prescription": {
      "description": "Top-level fields apply to every iteration. A matching iterations entry overrides only its included fields.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "reps": { "$ref": "#/$defs/repsPrescription" },
        "weight": { "$ref": "#/$defs/weightQuantity" },
        "addedWeight": { "$ref": "#/$defs/weightQuantity" },
        "assistedWeight": { "$ref": "#/$defs/weightQuantity" },
        "distance": { "$ref": "#/$defs/distanceQuantity" },
        "duration": { "$ref": "#/$defs/durationQuantity" },
        "calories": { "$ref": "#/$defs/caloriesQuantity" },
        "effort": { "$ref": "#/$defs/effortTarget" },
        "loadStrategy": { "$ref": "#/$defs/loadStrategy" },
        "iterations": {
          "description": "One-based overrides. Semantic validation requires each iteration value to be unique and within a finite parent container's bounds.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/iterationPrescription" }
        }
      }
    }
  }
}
