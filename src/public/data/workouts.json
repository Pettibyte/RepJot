    {
      "id": "strength-and-cindy",
      "name": "Strength and Cindy",
      "notes": "Heavy triples and a bench block, then the Cindy benchmark AMRAP.",
      "root": {
        "id": "root",
        "type": "container",
        "strategy": "sequence",
        "strategyConfig": {},
        "children": [
          {
            "id": "squat-block",
            "type": "container",
            "name": "Back Squat",
            "strategy": "rounds",
            "strategyConfig": { "rounds": 3 },
            "children": [
              {
                "id": "back-squat-set",
                "type": "exercise",
                "exerciseId": "Barbell_Squat",
                "stimulus": "strength",
                "setType": "working",
                "prescription": {
                  "reps": 3,
                  "loadStrategy": {
                    "type": "ascending"
                  },
                  "iterations": [
                    { "iteration": 1, "reps": 5, "weight": { "value": 80, "unit": "kg" } },
                    { "iteration": 2, "weight": { "value": 90, "unit": "kg" } },
                    { "iteration": 3, "weight": { "value": 100, "unit": "kg" } }
                  ]
                }
              }
            ]
          },
          {
            "id": "bench-block",
            "type": "container",
            "name": "Bench Press",
            "strategy": "rounds",
            "strategyConfig": { "rounds": 4 },
            "children": [
              {
                "id": "bench-set",
                "type": "exercise",
                "exerciseId": "Barbell_Bench_Press_-_Medium_Grip",
                "stimulus": "hypertrophy",
                "setType": "working",
                "prescription": {
                  "reps": 8,
                  "weight": { "value": 60, "unit": "kg" },
                  "effort": { "type": "rir", "target": 2 },
                  "iterations": [
                    { "iteration": 4, "reps": 5, "effort": { "type": "failure" } }
                  ]
                }
              }
            ]
          },
          {
            "id": "cindy",
            "type": "container",
            "name": "Cindy",
            "strategy": "amrap",
            "strategyConfig": { "duration": { "value": 20, "unit": "minute" } },
            "resultCapture": {
              "mode": "scored",
              "scoreType": "rounds_and_reps",
              "childDetail": "optional"
            },
            "benchmark": { "name": "Cindy", "organization": "CrossFit" },
            "children": [
              {
                "id": "cindy-pull-ups",
                "type": "exercise",
                "exerciseId": "Pullups",
                "stimulus": "conditioning",
                "prescription": { "reps": 5 }
              },
              {
                "id": "cindy-push-ups",
                "type": "exercise",
                "exerciseId": "Pushups",
                "stimulus": "conditioning",
                "prescription": { "reps": 10 }
              },
              {
