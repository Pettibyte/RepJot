{
  "name": "repjot-google-drive-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check:schemas && bun run seed:check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "check:compat": "bun run build && bun scripts/check-browser-compat.ts",
    "check:schemas": "bun scripts/validate-schemas.ts",
    "seed": "bun scripts/seed-exercises.ts",
    "seed:check": "bun scripts/seed-exercises.ts check",
    "seed:bump": "bun scripts/seed-exercises.ts bump"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/node": "^26.2.0",
    "acorn": "^8.18.0",
    "ajv": "^8",
    "ajv-formats": "^3",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "~6",
    "vite": "latest"
  },
  "dependencies": {
    "core-js": "^3.50.0"
  }
}
